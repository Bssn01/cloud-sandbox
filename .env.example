# ─────────────────────────────────────────────────────────────────────────────
# Autonomous Agent — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Models / harnesses (active peers) ────────────────────────────────────────
# Claude Code and Codex run SIMULTANEOUSLY as collaborating peers. Both keys
# are required — neither is a fallback. Roles (plan/implement/review) are
# assigned per task; the reviewer is always the OTHER provider than the implementer.
ANTHROPIC_API_KEY=
CLAUDE_CODE_MODEL=claude-opus-4-8

OPENAI_API_KEY=
CODEX_MODEL=gpt-5-codex

# ── Paperclip (orchestrator) ─────────────────────────────────────────────────
PAPERCLIP_PORT=7000
PAPERCLIP_DASHBOARD_PORT=7001
# Global hard spend cap across all agents/roles (USD). Per-role caps live in org-chart.yaml.
# NOTE: two providers active ~doubles token spend — size this accordingly.
PAPERCLIP_GLOBAL_BUDGET_USD=25
# Default collaboration mode: relay (plan->implement->review) | council (joint plan + cross-review).
PAPERCLIP_WORKFLOW_MODE=council
# Max implementer revision rounds on review feedback before escalating to the user.
PAPERCLIP_MAX_REVIEW_ROUNDS=1

# ── OpenClaw (communication front door) ──────────────────────────────────────
OPENCLAW_GATEWAY_PORT=8080
# Only these senders may issue goals. Comma-separated channel-specific IDs.
OPENCLAW_ALLOWLIST=
# Start with Telegram; add channels in Phase 5.
TELEGRAM_BOT_TOKEN=

# ── Hermes memory ────────────────────────────────────────────────────────────
# Hot/local tier is Hermes built-in SQLite (no config needed).
# Shared/cloud tier = ONE external provider self-hosted on the VPS.
# Provider finalized in Phase 3 (hindsight | retaindb).
HERMES_MEMORY_PROVIDER=hindsight
# Endpoint of the self-hosted memory backend on the VPS (Phase 3).
HERMES_REMOTE_ENDPOINT=https://memory.example-vps.net
HERMES_REMOTE_API_KEY=
# Shared namespace so all sub-agents see the same org memory.
HERMES_SHARED_NAMESPACE=org-default

# ── Memory MCP gateway (local) ───────────────────────────────────────────────
MEMORY_MCP_PORT=9100
